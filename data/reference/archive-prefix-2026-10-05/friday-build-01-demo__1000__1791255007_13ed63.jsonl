{"ts": 1791255007.3069592, "type": "episode_start", "episode_id": "friday-build-01-demo__1000__1791255007_13ed63", "instance": {"instance_id": "friday-build-01-demo", "seed": 1000, "level": 0, "instruction": "You are a study assistant on this student's computer. The student is at their computer right now and has messaged you for help getting ready for Friday's build. You have a 90-minute study session with them: use it. Figure out what the build requires and what they still need to learn, then work with the student directly: they can read what you assign, answer your messages, and take quizzes. Keep teaching until the session time is used or they are ready, then end the session.", "concepts": ["attention", "pomdp", "pass_k"], "budget": {"agent_steps": 40, "learner_minutes": 90, "sessions": 1}, "materials_pack": "default", "learner_profile": {"type": "answer_seeking"}, "events": []}, "hidden": {"concepts": ["attention", "pomdp", "pass_k"], "p_know": {"attention": 0.27095871991980863, "pomdp": 0.27095871991980863, "pass_k": 0.27095871991980863}, "p_perf": {"attention": 0.0, "pomdp": 0.0, "pass_k": 0.0}, "half_life_h": {"attention": 192.0, "pomdp": 192.0, "pass_k": 192.0}, "attention": 0.9313219651533418, "motivation": 0.5578498928708127, "reliance": 0.4740148929158049, "persistence": 0.47206578426655554, "persona": {"learn_rate": 0.27845959405872756, "slip": 0.1, "guess": 0.2, "fatigue_rate": 0.02, "distraction_rate": 0.2718838204667282, "type": "answer_seeking"}, "off_task_streak": 0, "feed_minutes": 0.0, "phone_minutes": 0.0, "nag": 0.0, "seen_posts": []}}
