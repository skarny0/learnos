{"ts": 1791259628.636447, "type": "step", "step": 27, "action": "notes_append", "args": {"note_id": "writeup", "text": "\n\n## Evaluation scaffold\nWe evaluated the agent over 3 seeds. A run counted as successful if the agent correctly completed the assigned task without needing corrective intervention. We report pass^3, meaning the agent must succeed on all 3 runs, rather than pass@3, where success on any one run would count. We chose pass^3 because it measures reliability more strictly, which is more useful for deployment-oriented evaluation.\n"}, "output": "Appended.", "t": 21, "activity": [], "events": [{"type": "note_edit", "note_id": "writeup", "by": "agent"}], "hidden": {"concepts": ["attention", "pomdp", "pass_k"], "p_know": {"attention": 0.28491492420433073, "pomdp": 0.28491492420433073, "pass_k": 0.6122905118881857}, "p_perf": {"attention": 0.0, "pomdp": 0.0, "pass_k": 1.0}, "half_life_h": {"attention": 192.0, "pomdp": 192.0, "pass_k": 192.0}, "attention": 0.8031484564271079, "motivation": 0.514715486329607, "reliance": 0.41644044389342016, "persistence": 0.4321403494397588, "persona": {"learn_rate": 0.3454780813133309, "slip": 0.1, "guess": 0.2, "fatigue_rate": 0.02, "distraction_rate": 0.35777747845078955, "type": "answer_seeking"}, "off_task_streak": 0, "feed_minutes": 2.0, "phone_minutes": 5.0, "nag": 2.7731, "seen_posts": ["p5"], "extra": {}}}
